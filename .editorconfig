# Editor defaults matching the existing style. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell scripts: 2-space indent, no tabs (the whole codebase's convention).
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (two trailing spaces are a hard line break).
[*.md]
trim_trailing_whitespace = false

# Makefiles, if any, require real tabs.
[Makefile]
indent_style = tab
