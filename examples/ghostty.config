# ============================================================================
# MountainLabs terminal — Ghostty config
# Brand theme + eye-comfort layer, paired with the MountainLabs statusline.
# https://github.com/ClearMountainDigital/mountainlabs-statusline
# Copy to ~/.config/ghostty/config (optional — the statusline works in any terminal).
# Reload after editing: Cmd+Shift+,   (or quit & reopen Ghostty)
# NOTE: Ghostty comments must be on their OWN line. A trailing "# ..." after a
#       value is read as part of the value and errors out.
# ============================================================================

# ---- font (Nerd Font — provides the statusline's branch/folder/powerline glyphs)
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# ---- MountainLabs palette ---------------------------------------------------
background = 26140A
foreground = F2F2F2
cursor-color = 8C4820
cursor-text = F2F2F2
selection-background = 495B6C
selection-foreground = F2F2F2

# 16 base colors. Warm brand hues, but green stays green and red stays red so
# diffs (add/remove) and errors remain unambiguous. Pairs are normal / bright.
# black / bright-black (warm gray)
palette = 0=#2b1810
palette = 8=#7c7768
# red — deletions, errors / bright red
# Note: on this warm-dark bg even #ff0000 tops out at ~4.4:1, so saturated red
# can't reach WCAG AA (4.5) without going coral. Normal red sits as red as it
# can (~4:1, UI-legible); bright red carries the AA-compliant emphasis red.
palette = 1=#e13a2a
palette = 9=#ee6c64
# green — additions, success / bright green
palette = 2=#6fa36b
palette = 10=#8fbe7e
# yellow — warnings, warm amber / bright yellow
palette = 3=#c08a4e
palette = 11=#e0a860
# blue — slate / bright blue
palette = 4=#6b84a0
palette = 12=#8aa6c4
# magenta — muted mauve / bright magenta
palette = 5=#ad8092
palette = 13=#c08fa0
# cyan — desaturated teal / bright cyan
palette = 6=#6ba39b
palette = 14=#8fc4bc
# white — warm light gray / bright white (cream)
palette = 7=#c9c4bc
palette = 15=#f2f2f2

# ---- eye-comfort layer ------------------------------------------------------
# Contrast floor: keeps any text legible over its background. Raise toward 3
# for stronger accessibility (may flatten some brand nuance); lower to 1 to
# disable. 1.1 is a gentle safety net that leaves the theme intact.
minimum-contrast = 1.1

# Breathing room + line spacing (less cramped = easier on the eyes)
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
adjust-cell-height = 10%

# Calm, steady brand-colored cursor (no blink = less distracting)
cursor-style = block
cursor-style-blink = false

# Small quality-of-life
mouse-hide-while-typing = true
